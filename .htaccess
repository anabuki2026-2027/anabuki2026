# 【このファイルは？】
# XAMPP（Apache）への指示書。
# このフォルダに来た人を、全員 webroot フォルダへ案内する。
#
# 【担当】なし（編集しない。自動で作られたり、上書きされたりするため）
# 【くわしく】docs/FILES.md

<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteRule    ^(\.well-known/.*)$ $1 [L]
    RewriteRule    ^$    webroot/    [L]
    RewriteRule    (.*) webroot/$1    [L]
</IfModule>
